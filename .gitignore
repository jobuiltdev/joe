# Ignore environment variables
.env

# Ignore Python compiled files
*.pyc
__pycache__/

# Ignore SQLite database file
db.sqlite3

# Ignore virtual environments
venv/
.venv/

# static/ is the SOURCE directory and is tracked.
# staticfiles/ is the collectstatic output, but it stays tracked too: Vercel's
# @vercel/python builder runs no build step, so nothing regenerates it there.
# Run `python manage.py collectstatic` and commit the result before deploying.

# Ignore IDE-specific files
.vscode/
.idea/

# macOS junk
.DS_Store